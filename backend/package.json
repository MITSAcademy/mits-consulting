{
  "name": "mits-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node --max-old-space-size=400 dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed:rishi": "tsx src/seed/addRishi.ts",
    "seed:fix-pay-dates": "tsx src/seed/fixPayDates.ts",
    "seed:fix-pay-dates-2": "tsx src/seed/fixPayDates2.ts",
    "seed:fix-payment-frequency": "tsx src/seed/fixPaymentFrequency.ts",
    "seed:brain": "tsx src/seed/brainNotesSeed.ts",
    "seed:contacts": "tsx src/seed/updateTeamContacts.ts",
    "seed": "tsx src/seed/index.ts",
    "seed:demo": "tsx src/seed/demo.ts",
    "seed:big": "tsx src/seed/big.ts",
    "seed:stress": "tsx src/seed/stress.ts",
    "test": "jest --testPathPattern=src/tests",
    "test:rbac": "jest rbac.stress",
    "test:smoke": "node scripts/smoke.js",
    "postinstall": "prisma generate"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "esModuleInterop": true
        }
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.23",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
