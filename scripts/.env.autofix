# Copy this to .env.autofix and fill in real values
# Run the server with: node autofix-webhook.js (loads .env.autofix automatically via dotenv)

# Shared secret between this server and the Render backend
# Generate with: openssl rand -hex 32
AUTOFIX_WEBHOOK_SECRET=9935ea31716d6581d1b26e4472954cc0e413293a8af645104c1e5abf8bf52112

# Port this server listens on (expose via ngrok)
AUTOFIX_PORT=7891

# Path to the mits-consulting repo on this machine
MITS_REPO_PATH=/Users/shivamaggarwal/mits-consulting

# Backend URL for patching bug status after fix
MITS_BACKEND_URL=https://mits-backend.onrender.com

# A valid founder JWT token (login to the portal, grab from browser devtools → Application → localStorage)
# This lets the webhook patch bug status back in the portal
AUTOFIX_BACKEND_SECRET=9935ea31716d6581d1b26e4472954cc0e413293a8af645104c1e5abf8bf521126
